                <stringProp name="script">today = new Date()

delta1 = new Random().nextInt(10)
delta2 = new Random().nextInt(10)+10
date1 = today.plus(delta1).format(&quot;MM/dd/yyyy&quot;)
date2 = today.plus(delta2).format(&quot;MM/dd/yyyy&quot;)

def roundtrip = new Random().nextInt(100) &gt;= 75 ? &quot;1&quot; : &quot;0&quot;
//def roundtrip = &quot;1&quot;

vars.put(&quot;roundtrip&quot;,roundtrip)
vars.put(&quot;departDate&quot;,date1)
vars.put(&quot;arriveDate&quot;,date2)</stringProp>

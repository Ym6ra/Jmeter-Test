              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def login = &quot;u&quot; + UUID.randomUUID().toString().replace(&quot;-&quot;, &quot;&quot;).substring(0, 13)
def password = UUID.randomUUID().toString().replace(&quot;-&quot;, &quot;&quot;).substring(0, 10)
def pass = new StringBuilder()

vars.put(&quot;login&quot;, login)
vars.put(&quot;password&quot;, password)
vars.put(&quot;firstName&quot;, login)
vars.put(&quot;lastName&quot;, login)
vars.put(&quot;address1&quot;, login)
vars.put(&quot;address2&quot;, login)

pass.append(&quot;login&quot;)
	.append(&quot;: &quot;)
	.append(login)
	.append(&quot;  &quot;)
	.append(&quot;password&quot;)
	.append(&quot;: &quot;)
	.append(password)
	.append(&quot;\n&quot;)


new File(&quot;pass.txt&quot;).append(pass.toString() + System.lineSeparator(), &quot;UTF-8&quot;)
</stringProp>
              </JSR223PreProcessor>

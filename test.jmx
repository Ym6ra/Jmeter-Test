                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="script">def body = []

int flightCnt = (vars.get(&quot;flightID_matchNr&quot;) ?: &quot;0&quot;) as int
for (int i = 1; i &lt;= flightCnt; i++) {
    body &lt;&lt; &quot;flightID=&quot; + vars.get(&quot;flightID_&quot; + i)
}

int fieldCnt = (vars.get(&quot;cgifields_matchNr&quot;) ?: &quot;0&quot;) as int
for (int i = 1; i &lt;= fieldCnt; i++) {
    body &lt;&lt; &quot;.cgifields=&quot; + vars.get(&quot;cgifields_&quot; + i)
}

body &lt;&lt; &quot;removeAllFlights.x=24&quot;
body &lt;&lt; &quot;removeAllFlights.y=11&quot;

vars.put(&quot;deleteRequestBody&quot;, body.join(&quot;&amp;&quot;))</stringProp>

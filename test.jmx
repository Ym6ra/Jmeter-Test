          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def html = prev.getResponseDataAsString()

def count = vars.get(&quot;Name_matchNr&quot;) as int

def result = new StringBuilder()

for(int i=1; i&lt;=count; i++){

    def title = vars.get(&quot;Name_&quot; + i)

    int startPos = html.indexOf(title)

    int endPos

    if(i &lt; count){
        def nextTitle = vars.get(&quot;Name_&quot; + (i+1))
        endPos = html.indexOf(nextTitle, startPos)
    }else{
        endPos = html.length()
    }

    def sectionHtml = html.substring(startPos, endPos)

    def sectionText = sectionHtml.replaceAll(&quot;&lt;[^&gt;]*&gt;&quot;, &quot;&quot;)

    int length = sectionText.length()

    result.append(i)
          .append(&quot; : &quot;)
          .append(title)
          .append(&quot; : &quot;)
          .append(length)
          .append(&quot;\n&quot;)
}

new File(&quot;result.txt&quot;).write(result.toString(), &quot;UTF-8&quot;)</stringProp>
          </JSR223PostProcessor>
